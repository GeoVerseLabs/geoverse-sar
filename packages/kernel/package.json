{
  "name": "@geoverse-sar/kernel",
  "version": "0.1.0",
  "description": "Spatial Application Runtime kernel — Capability / Dispatcher / Workflow / TransactionGroup over a generic diff port. Zero domain, zero map library.",
  "type": "module",
  "license": "MIT",
  "author": "DIY Liu",
  "keywords": [
    "runtime",
    "capability",
    "workflow",
    "undo",
    "ai-native",
    "geoverse"
  ],
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store-idb": {
      "types": "./dist/store-idb.d.ts",
      "import": "./dist/store-idb.js"
    },
    "./store-file": {
      "types": "./dist/store-file.d.ts",
      "import": "./dist/store-file.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.0.0",
    "vite-plugin-dts": "^5.0.2"
  }
}
