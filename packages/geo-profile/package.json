{
  "name": "@geoverse-sar/geo-profile",
  "version": "0.1.0",
  "description": "Shared geo schema profile for SAR capability packs: canonical Geometry/Feature/FeatureRef/BBox/CRS/Quantity Zod schemas + pure bbox utilities. Leaf library (zod only) — never imported by the kernel.",
  "type": "module",
  "license": "MIT",
  "author": "DIY Liu",
  "keywords": [
    "gis",
    "schema",
    "zod",
    "runtime",
    "geoverse"
  ],
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "vite-plugin-dts": "^5.0.2"
  }
}
