{
  "name": "@geoverse-sar/eval",
  "version": "0.1.0",
  "description": "Deterministic eval harness for SAR: scenario model with declarative assertions, a runner that pins final state via canonical hashing, and a scripted LLM for goal-driven deterministic runs (RFC-0011).",
  "type": "module",
  "license": "MIT",
  "author": "DIY Liu",
  "keywords": [
    "eval",
    "regression",
    "runtime",
    "geoverse"
  ],
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@geoverse-sar/kernel": "workspace:*",
    "@geoverse-sar/planner": "workspace:*"
  },
  "devDependencies": {
    "@geoverse-sar/capabilities-records": "workspace:*",
    "@geoverse-sar/engine-memory": "workspace:*",
    "@geoverse-sar/evolution": "workspace:*",
    "vite-plugin-dts": "^5.0.2"
  }
}
