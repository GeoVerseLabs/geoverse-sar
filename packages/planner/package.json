{
  "name": "@geoverse-sar/planner",
  "version": "0.1.0",
  "description": "NL-to-capability routing planner for the SAR kernel (M3): provider-agnostic LlmClient + tool-use loop over toToolSpecs/handleToolCall, streaming progress events, and a headless chat controller for UI binding. The kernel stays NL-free.",
  "type": "module",
  "license": "MIT",
  "author": "DIY Liu",
  "keywords": [
    "ai",
    "planner",
    "tool-use",
    "streaming",
    "headless",
    "runtime",
    "geoverse"
  ],
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@geoverse-sar/kernel": "workspace:*",
    "@geoverse-sar/skill": "workspace:*"
  },
  "devDependencies": {
    "@geoverse-sar/capabilities-records": "workspace:*",
    "@geoverse-sar/engine-memory": "workspace:*",
    "vite-plugin-dts": "^5.0.2"
  }
}
