{
  "name": "@geoverse-sar/otel",
  "version": "0.1.0",
  "description": "OpenTelemetry exporter for SAR (RFC-0009 F4, optional): invoke spans via middleware, workflow/engine events bridged onto the trace. Bring your own provider — depends on @opentelemetry/api only.",
  "type": "module",
  "license": "MIT",
  "author": "DIY Liu",
  "keywords": [
    "runtime",
    "opentelemetry",
    "observability",
    "geoverse"
  ],
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@geoverse-sar/kernel": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@geoverse-sar/capabilities-records": "workspace:*",
    "@geoverse-sar/engine-memory": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "vite-plugin-dts": "^5.0.2",
    "zod": "^4.1.0"
  }
}
