  {
    "id": "history.redo",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "done": {
          "type": "boolean"
        }
      },
      "required": [
        "done"
      ],
      "additionalProperties": false
    }
  },
  {
    "id": "view.focus",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ids": {
          "description": "聚焦这批要素的整体范围中心",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "setId": {
                  "type": "string",
                  "description": "命名集句柄（features.query 等 read 能力返回）"
                }
              },
              "required": [
                "setId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "ids": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "显式要素 id 列表"
                }
              },
              "required": [
                "ids"
              ]
            },
            {
              "type": "object",
              "properties": {
                "filter": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "属性全等过滤（对当前编辑区即时求值）"
                }
              },
              "required": [
                "filter"
              ]
            }
          ],
          "description": "目标要素（三选一）：{setId} / {ids} / {filter}"
        },
        "center": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      }
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "center": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "center",
        "ids"
      ],
      "additionalProperties": false
    }
  },
  {
    "id": "view.zoom",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "level": {
          "description": "绝对缩放级别（与 delta 二选一）",
          "type": "number"
        },
        "delta": {
          "description": "增量，如 +1 放大一级、-2 缩小两级",
          "type": "number"
        }
      }
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "level": {
          "type": "number"
        }
      },
      "required": [
        "level"
      ],
      "additionalProperties": false
    }
  },
  {
    "id": "view.setBase",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "底图名（宿主定义）；GMap 常见值：gd-vec 高德矢量 / gd-sat 高德影像 / bd-vec 百度矢量 / bd-sat 百度影像 / ocean 海图。名字不合法会报错并列出可用值。"
        }
      },
      "required": [
        "name"
      ]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "base": {
          "type": "string"
        }
      },
      "required": [
        "base"
      ],
      "additionalProperties": false
    }
  },
  {
    "id": "workflow.highlightAndNudge",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "propsEquals": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "属性全等匹配目标要素，如 {\\"type\\":\\"building\\"}"
        },
        "dx": {
          "default": 1,
          "description": "轻移 x 分量",
          "type": "number"
        },
        "dy": {
          "default": 0,
          "description": "轻移 y 分量",
          "type": "number"
        }
      },
      "required": [
        "propsEquals"
      ]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "setId": {
          "type": "string",
          "description": "命中集句柄（后续可继续用 target:{setId} 指代）"
        },
        "count": {
          "type": "number"
        }
      },
      "required": [
        "setId",
        "count"
      ],
      "additionalProperties": false
    }
  }
]"
`;
