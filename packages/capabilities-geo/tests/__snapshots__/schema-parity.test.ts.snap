  {
    "id": "region.select",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ring": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ]
          },
          "description": "区域外环顶点序列（自动闭合）；矩形给四角即可"
        },
        "predicate": {
          "default": "intersects",
          "description": "命中判定：intersects=相交即中 / contains=完全落入才中",
          "type": "string",
          "enum": [
            "intersects",
            "contains"
          ]
        }
      },
      "required": [
        "ring"
      ]
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
