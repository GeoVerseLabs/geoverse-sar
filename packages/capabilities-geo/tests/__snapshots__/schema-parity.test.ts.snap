          "type": "number"
        },
        "sample": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "前 10 个命中 id"
        }
      },
      "required": [
        "setId",
        "count",
        "sample"
      ],
      "additionalProperties": false
    }
