exports[`U0-3 schema 迁移平价 > 全部 geo 能力（含工作流投影）的 input/output JSON Schema 快照不变 1`] = `
"[
  {
    "id": "features.query",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ids": {
          "description": "按 id 精确取；与其他条件求交",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "propsEquals": {
          "description": "属性全等匹配，如 {\\"type\\":\\"building\\"}",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "where": {
          "description": "属性谓词条件（gt/lt/range/oneOf/contains 等），多条按 logic 组合",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "description": "属性字段名"
              },
              "op": {
                "type": "string",
                "enum": [
                  "eq",
                  "neq",
                  "gt",
                  "lt",
                  "range",
                  "oneOf",
                  "contains"
                ]
              },
              "value": {
                "description": "eq/neq/gt/lt/contains 的比较值"
              },
              "min": {
                "description": "range 下界",
                "type": "number"
              },
              "max": {
                "description": "range 上界",
                "type": "number"
              },
              "values": {
                "description": "oneOf 候选值",
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "field",
              "op"
            ]
          }
        },
        "logic": {
          "default": "and",
          "description": "where 多条件的组合方式",
          "type": "string",
          "enum": [
            "and",
            "or"
          ]
        },
        "bbox": {
          "description": "[minX, minY, maxX, maxY] 空间范围过滤（要素 bbox 相交即命中）",
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "setId": {
          "type": "string",
          "description": "命中结果的命名集句柄——写能力用 target:{setId} 指代这批要素"
        },
        "count": {
          "type": "number",
          "description": "命中总数"
        },
        "sample": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "geometryType": {
                "type": "string"
              },
              "bbox": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "center": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "props": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "geometryType",
              "bbox",
              "center",
              "props"
            ],
            "additionalProperties": false
          },
          "description": "前 10 条摘要（不全量倾倒坐标）"
        },
        "hasMore": {
          "type": "boolean",
          "description": "命中数超出 sample——用 setId 指代全部"
        }
      },
      "required": [
        "setId",
        "count",
        "sample",
        "hasMore"
      ],
      "additionalProperties": false
    }
  },
