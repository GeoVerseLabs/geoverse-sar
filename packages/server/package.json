{
  "name": "@geoverse-sar/server",
  "version": "0.1.0",
  "description": "SAR service form — thin HTTP+WS layer over the kernel funnel: wire = InvokeOutcome, token → CallerInfo, EventBus bridged to WebSocket. Node-only.",
  "type": "module",
  "license": "MIT",
  "author": "DIY Liu",
  "keywords": [
    "runtime",
    "server",
    "http",
    "websocket",
    "geoverse"
  ],
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@geoverse-sar/kernel": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@geoverse-sar/capabilities-records": "workspace:*",
    "@geoverse-sar/engine-memory": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "vite-plugin-dts": "^5.0.2",
    "zod": "^4.1.0"
  }
}
